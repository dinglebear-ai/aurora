# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.gradle/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
logs
.beads/
.claire/
.claude/worktrees/
.worktrees/
.lavra
.broadcastr
# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/android/aurora/src/test/snapshots/images/*_actual.png
/android/aurora/src/test/snapshots/images/*_compare.png

# next.js
/.next/
/out/

# production
/build
/ops/compose/production.env
/ops/rendered-swag/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!/ops/compose/production.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# webwright / screenshot scratch
/outputs/

# codex marketplace assets (large generated PNGs, not part of the registry)
/public/codex-marketplace/

*storybook.log
storybook-static

# design-sync converter working dirs (generated capture/bundle output;
# source of truth is scripts/design-sync-converter/)
/.design-sync/
/.ds-sync/
/ds-bundle/
