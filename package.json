{
  "name": "registry",
  "version": "0.5.1",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "pnpm run generated:check && pnpm run readmes:generate && next build && pnpm run standalone:sanitize",
    "standalone:sanitize": "node scripts/sanitize-standalone.mjs",
    "start": "next start",
    "lint": "eslint .",
    "audit:composition": "node scripts/audit-composition.mjs",
    "audit:standalone": "node scripts/audit-standalone.mjs",
    "test:unit": "node --test tests/*.test.ts",
    "test:coverage": "c8 node --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "performance:check": "node scripts/check-web-performance.mjs",
    "test:storybook": "playwright test --config=playwright.storybook.config.ts",
    "dendrite:sync": "node scripts/dendrite-catalog.mjs",
    "registry:build": "shadcn build",
    "registry:check": "node scripts/check-registry-drift.mjs",
    "registry:validate": "node scripts/validate-registry-capabilities.mjs",
    "registry:graph": "node scripts/validate-registry-graph.mjs",
    "registry:smoke": "node scripts/smoke-registry-install.mjs",
    "registry:smoke:base": "AURORA_REGISTRY_SMOKE_PROFILES=base node scripts/smoke-registry-install.mjs",
    "tokens:export": "node scripts/export-aurora-tokens.mjs",
    "tokens:generate": "node scripts/export-aurora-tokens.mjs && node android/sd.config.mjs",
    "readmes:generate": "node scripts/generate-readmes.mjs",
    "gallery:generate": "node scripts/generate-gallery-entries.mjs",
    "gallery:check": "node scripts/generate-gallery-entries.mjs --check",
    "catalog:generate": "node scripts/generate-client-catalog.mjs",
    "catalog:check": "node scripts/generate-client-catalog.mjs --check",
    "generated:generate": "pnpm gallery:generate && pnpm catalog:generate",
    "generated:check": "node scripts/check-generated-artifacts.mjs",
    "skill:sync": "node scripts/sync-agent-skill.mjs",
    "skill:check": "node scripts/sync-agent-skill.mjs --check && ops/check-skill-sync.sh",
    "refs:check": "node scripts/migrate-react19-refs.mjs --check",
    "catalog:device:generate": "node scripts/generate-device-catalog.mjs",
    "catalog:device:check": "node scripts/generate-device-catalog.mjs --check",
    "catalog:device:dev": "pnpm --dir apps/device-catalog dev",
    "catalog:device:build": "pnpm --dir apps/device-catalog build",
    "catalog:device:tauri": "pnpm --dir apps/device-catalog tauri",
    "catalog:device:android": "pnpm --dir apps/device-catalog tauri:android:dev",
    "catalog:device:android:build": "pnpm --dir apps/device-catalog tauri:android:build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-menubar": "^1.1.24",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.16.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^10.5.5",
    "@storybook/addon-docs": "^10.5.5",
    "@storybook/nextjs-vite": "^10.5.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "c8": "^12.0.0",
    "css-tree": "3.2.1",
    "esbuild": "^0.28.1",
    "eslint": "^9.32.0",
    "eslint-config-next": "16.3.0",
    "eslint-plugin-storybook": "^10.5.5",
    "storybook": "^10.5.5",
    "style-dictionary": "5.5.0",
    "tailwindcss": "^4.3.3",
    "tiny-glob": "^0.2.9",
    "ts-morph": "^28.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.0",
    "yaml": "2.9.0"
  },
  "pnpm": {
    "overrides": {
      "@hono/node-server": "2.0.10",
      "@modelcontextprotocol/sdk": "1.30.0",
      "minimatch@10.2.5>brace-expansion": "5.0.9",
      "fast-uri": "3.1.5",
      "hono": "4.12.34",
      "ip-address": "10.3.1",
      "postcss": "8.5.23",
      "undici": "7.29.0"
    }
  }
}
