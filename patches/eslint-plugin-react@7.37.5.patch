diff --git a/lib/minimatch-compat.js b/lib/minimatch-compat.js
new file mode 100644
index 0000000000000000000000000000000000000000..ccecab273e4dcd4c959b261e9b23db2843e3e5bc
--- /dev/null
+++ b/lib/minimatch-compat.js
@@ -0,0 +1,8 @@
+'use strict';
+
+// minimatch 10 exports its callable matcher as `minimatch` rather than the
+// package default. Preserve eslint-plugin-react's legacy callable import.
+var modern = require('minimatch');
+var compat = modern.minimatch || modern;
+Object.assign(compat, modern);
+module.exports = compat;
